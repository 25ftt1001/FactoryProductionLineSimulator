<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ChangePasswordController" styleClass="root-pane">

    <VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="650.0" prefWidth="850.0" styleClass="window-container light-bg">
        
        <!-- Top Bar with Back link and Title -->
        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="top-bar">
            <padding><Insets left="18.0" top="12.0" bottom="12.0" right="18.0"/></padding>
            <Hyperlink text="← Back" onAction="#handleBack" styleClass="back-link" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Change Password" styleClass="top-bar-title" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="       " />
        </HBox>

        <!-- Form Content -->
        <VBox alignment="CENTER_LEFT" spacing="8.0" styleClass="form-container">
            
            <Region minHeight="10.0" />

            <!-- Email (needed to identify the account) -->
            <Label text="EMAIL ADDRESS" styleClass="input-label" />
            <TextField fx:id="emailField" promptText="you@example.com" styleClass="input-field" />

            <!-- New Password -->
            <Label text="NEW PASSWORD" styleClass="input-label" />
            <PasswordField fx:id="newPasswordField" promptText="••••••••" styleClass="input-field" />

            <!-- Confirm New Password -->
            <Label text="CONFIRM NEW PASSWORD" styleClass="input-label" />
            <PasswordField fx:id="confirmPasswordField" promptText="••••••••" styleClass="input-field" />

            <Region minHeight="10.0" />

            <!-- Password Requirements Box -->
            <VBox spacing="6.0" styleClass="requirements-box">
                <Label text="PASSWORD REQUIREMENTS" styleClass="requirements-title" />
                <Label text="✓ Minimum 8 characters" styleClass="requirements-item" />
                <Label text="✓ At least 1 number" styleClass="requirements-item" />
                <Label text="✓ At least 1 uppercase letter" styleClass="requirements-item" />
            </VBox>

            <Region minHeight="15.0" />

            <!-- Action Buttons -->
            <HBox alignment="CENTER" spacing="20.0" maxWidth="Infinity">
                <Button text="CANCEL" onAction="#handleBack" styleClass="secondary-button" prefWidth="280.0" prefHeight="45.0" />
                <Button text="CHANGE PASSWORD" onAction="#handleUpdatePassword" styleClass="primary-button" prefWidth="400.0" prefHeight="45.0" />
            </HBox>

        </VBox>
    </VBox>
</StackPane>